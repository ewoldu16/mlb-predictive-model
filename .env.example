# Local defaults; Render supplies PORT and DATABASE_URL automatically.
PORT=5000
HOST=127.0.0.1
REFRESH_INTERVAL_SECONDS=600
MLB_STATE_DIR=data/live
# Optional locally. In production this is the Supabase PostgreSQL connection URL.
SUPABASE_DATABASE_URL=
# Legacy/direct PostgreSQL alias supported for local development.
DATABASE_URL=
# Optional inactive adapter only; production does not require RotoWire.
ROTOWIRE_API_KEY=
# Required to enable the private /owner control panel. Generate a password hash
# with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('CHANGE-ME'))"
OWNER_USERNAME=
OWNER_PASSWORD_HASH=
SECRET_KEY=
OWNER_SESSION_MINUTES=30
